APP_NAME=CSOS
ENVIRONMENT=development
DEBUG=true

# Replace this value outside local development.
JWT_SECRET_KEY=change-me-in-production-32-bytes-minimum
JWT_ALGORITHM=HS256
JWT_ISSUER=csos-auth
JWT_PLATFORM_AUDIENCE=csos-platform
JWT_MCP_AUDIENCE=csos-mcp
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEMO_ADMIN_EMAIL=admin@csos.com
DEMO_ADMIN_PASSWORD=csos-demo
MAX_IMPORT_ROWS=5000

# Collection credentials use an independent rotatable key ring. Replace the
# first value in production; retain an old value temporarily during rotation.
CONNECTOR_ENCRYPTION_KEYS=change-me-connector-encryption-key
# Optional comma-separated CIDR allow-list for SSH/SNMP/REST connector targets.
# Empty permits normal private/public targets but still blocks loopback,
# link-local, multicast and cloud metadata addresses.
CONNECTOR_ALLOWED_CIDRS=
CONNECTOR_REQUEST_TIMEOUT_SECONDS=30
CONNECTOR_IMPORT_ROOT=/data/imports
CONNECTOR_MAX_IMPORT_BYTES=25000000
SCHEDULER_ENABLED=false
SCHEDULER_TICK_SECONDS=60
SYSLOG_ENABLED=false
SYSLOG_BIND_ADDRESS=127.0.0.1
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
SYSLOG_MAX_MESSAGE_BYTES=65536

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=csos
POSTGRES_USER=csos
POSTGRES_PASSWORD=csos_password

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=csos_password

# The AI runtime is provider-independent at the application boundary. Ollama is
# the default local provider; any compatible local/sovereign model can be added
# to this comma-separated allow-list without changing the platform architecture.
AI_PROVIDER=ollama
AI_DEFAULT_MODEL=llama3.1
AI_AVAILABLE_MODELS=llama3.1,deepseek-r1,qwen2.5,mistral,allam
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

CORS_ORIGINS=http://localhost:3000
