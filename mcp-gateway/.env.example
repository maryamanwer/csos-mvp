MCP_SERVER_NAME=CSOS MCP Gateway
MCP_SERVER_VERSION=0.3.0
MCP_BACKEND_URL=http://backend:8000/api/v1
MCP_ISSUER_URL=http://localhost:8000/api/v1/auth
MCP_RESOURCE_URL=http://localhost:8001/mcp

# These values must match the CSOS backend JWT configuration.
MCP_JWT_SECRET_KEY=change-me-in-production-32-bytes-minimum
MCP_JWT_ALGORITHM=HS256
MCP_JWT_ISSUER=csos-auth
MCP_JWT_AUDIENCE=csos-mcp

# Docker/Codespaces already place the service behind a trusted reverse proxy.
# Set this to true and provide exact hosts/origins for a direct production bind.
MCP_DNS_REBINDING_PROTECTION=false
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,mcp-gateway:8001
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8001
